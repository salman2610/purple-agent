            margin: 0,
            fontWeight: '400'
          }}>
            {authMode === "login" ? "Sign in to your dashboard" : "Join us today"}
          </p>
        </div>
        
        {/* Enhanced Message Display */}
        {message && (
          <div style={{
            padding: "15px 20px",
            borderRadius: "12px",
            textAlign: "center",
