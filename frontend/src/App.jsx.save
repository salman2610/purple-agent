            overflow: 'hidden'
          }}>
            <div style={{
              position: 'absolute',
              top: 0,
              left: 0,
              right: 0,
              bottom: 0,
              background: 'linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent)',
              transform: 'translateX(-100%)',
              animation: 'shimmer 3s infinite'
            }} />
            SM
          </div>
          <h2 style={{ 
            color: '#fff', 
            marginBottom: "10px",
