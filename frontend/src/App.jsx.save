                  Refresh User Info
                </button>
                <button onClick={fetchLatestAgentData} disabled={dashboardLoading} style={{
                  ...darkStyles.button,
                  background: dashboardLoading ? DARK_THEME.glassBorder : 'rgba(220, 38, 38, 0.2)',
