                }}>
                  {dashboardLoading ? <TailSpin height={20} width={20} /> : "Refresh Agent Data"}
                </button>
                {(currentUser?.role === 'agent' || currentUser?.role === 'admin') && (
                  <button onClick={submitSampleAgentData} disabled={dashboardLoading} style={{ 
